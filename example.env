# Portainer: Stacks → Environment variables → Load variables from .env file
# Local Compose: cp example.env .env  (then edit PUBLIC_HOST if needed)
#
# Change PUBLIC_HOST to this machine's LAN IP (or localhost for same-device only).
#
# APP_VERSION is optional. Leave 0.0.0 / unset and the web image stamps the
# nearest git tag at build (same idea as Electron releases). Set explicitly
# only to override (semver without leading "v"). The update toast stays off
# when no tag/version can be resolved (e.g. shallow clone without tags).

PUBLIC_HOST=192.168.0.148
WEB_PORT=8088
PORT=3210
SITE_PROXY_PORT=3211
DASHBOARD_PORT=6791
APP_VERSION=0.0.0
INSTANCE_NAME=vctr
INSTANCE_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff00
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

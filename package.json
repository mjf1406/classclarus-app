{
  "name": "vctr",
  "version": "0.0.0",
  "private": true,
  "description": "vctr — classroom app template (web, self-host, Electron)",
  "author": "vctr",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjf1406/vctr.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "check": "vp check --fix && bun run lint:fix && bun run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "audit": "bun audit",
    "preview": "vp preview",
    "post-clone": "bun scripts/post-clone.mjs",
    "prepare": "vp config",
    "electron:download-backend": "bun scripts/download-convex-backend.mjs",
    "electron:build-main": "bun scripts/build-electron.mjs",
    "electron:dev": "bun scripts/electron-dev.mjs",
    "electron:pack": "bun scripts/electron-pack.mjs --dir",
    "electron:dist": "bun scripts/electron-pack.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "^1.6.0",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/polar": "0.9.2",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@djpanda/convex-authz": "^2.4.1",
